APPLICATION_NAME=qireadr
ACTIONS_REPOSITORY=gat516/book
ACTIONS_WORKFLOW=ci.yml
ACTIONS_BRANCH=main
# Optional server-side fine-grained token with Actions: read for this repo only.
# Without a token, public results refresh every ten minutes to limit API usage.
ACTIONS_READ_TOKEN=
SERVICE_HEALTH_URL=https://qireadr.com/api/healthz
PORT=8080
CORS_ORIGINS=http://localhost:5173
# Optional: absolute path to a built frontend/dashboard/dist; Docker sets this.
DASHBOARD_STATIC_DIR=
